{
  "name": "jk-copycenter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "cloudflare:verify-secrets": "node scripts/verify-cloudflare-build-secrets.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && npm run cloudflare:verify-secrets && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types .wrangler/cloudflare-env.d.ts --env-interface CloudflareEnv"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.8.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.5",
    "node-unrar-js": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4",
    "swr": "^2.5.1",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sharp": "^0.31.1",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "js-yaml": "4.3.2",
    "qs": "6.16.0",
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260911.1": true
  }
}
