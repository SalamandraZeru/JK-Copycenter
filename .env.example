# ==============================================================================
# JK COPYCENTER — Variáveis de Ambiente (Template)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env.local no ambiente de desenvolvimento local.
# 2. Em produção, cadastre as variáveis e secrets no ambiente do Cloudflare Worker.
# 3. NUNCA faça commit de valores reais ou arquivos .env preenchidos no Git.
# ==============================================================================

# Supabase (Público - Frontend & SSR)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role (Privado - APENAS Backend/API Routes - NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=

# URL Base da Aplicação
NEXT_PUBLIC_SITE_URL=

# Liberação gradual do novo fluxo de orçamento gráfico.
# Deve permanecer false até a homologação das Etapas 2 a 12.
SERVICE_MANUAL_QUOTE_ENABLED=true

# Autenticação de Rotinas Agendadas / Webhooks (Opcional para Edge Functions)
CRON_SECRET=
