{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jk-copycenter",
  "main": "worker.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SERVICE_MANUAL_QUOTE_ENABLED": "true"
  },
  "ratelimits": [
    {
      "name": "JK_PRICING_PREVIEW_RATE_LIMIT",
      "namespace_id": "2026082601",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "JK_UPLOAD_INTENTS_RATE_LIMIT",
      "namespace_id": "2026082602",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "JK_UPLOAD_RATE_LIMIT",
      "namespace_id": "2026082603",
      "simple": { "limit": 15, "period": 60 }
    },
    {
      "name": "JK_PRIVACY_REQUEST_RATE_LIMIT",
      "namespace_id": "2026091401",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "JK_PUSH_SUBSCRIBE_RATE_LIMIT",
      "namespace_id": "2026100401",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "ORDER_FILES",
      "bucket_name": "jk-order-files"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Uma vez por dia (06:17 em Brasília): consulta leve que mantém o Supabase gratuito ativo.
  "triggers": {
    "crons": ["17 9 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
